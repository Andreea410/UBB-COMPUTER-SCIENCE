        on left: 30 31
        on right: 28
    whileStmt (67)
        on left: 32
        on right: 29
    condition (68)
        on left: 33
        on right: 30 31 32
    orCondition (69)
        on left: 34 35
        on right: 33
    andCondition (70)
        on left: 36 37
        on right: 34 35
    notCondition (71)
        on left: 38 39
        on right: 36 37 38
    relOp (72)
        on left: 40 41 42 43 44 45
        on right: 39
    expr (73)
        on left: 46 47 48
        on right: 24 39 58
